ARGS
<!(--outdir/-o)outdir>
<(--stage)stage>
  plan
<(--profile)profile>
  standard
<(--reads-per-sample)reads-per-sample>
  500000
<(--seed)seed>
  20260522
<(--threads/-t)threads>
  4
<(--limit-samples)limit-samples>
  0
<(--force)force>
  false
<(--resume)resume>
  false
<(--keep-lanes)keep-lanes>
  false

RUN
<taffish>
if false; then
    [[taf: taf-seqkit-v2.13.0-r2 seqkit version]]
    [[taf: taf-sra-tools-v3.4.1-r1 sra-info --version]]
fi

<shell>
set -eu

APP_NAME="rnaseq-yeast-get-data"
APP_VERSION="0.1.0-r1"
PROJECT_ACCESSION="PRJEB5348"
AUTHOR_COMMIT="375dc0d57d9d1fa96a4245a6530e0fda34305891"

OUTDIR="::outdir::"
STAGE="::stage::"
PROFILE="::profile::"
READS_PER_SAMPLE="::reads-per-sample::"
SEED="::seed::"
THREADS="::threads::"
LIMIT_SAMPLES="::limit-samples::"
FORCE="::force::"
RESUME="::resume::"
KEEP_LANES="::keep-lanes::"

SEQKIT_CMD="taf-seqkit-v2.13.0-r2"
SRA_CMD="taf-sra-tools-v3.4.1-r1"

ENA_REPORT_URL="https://www.ebi.ac.uk/ena/portal/api/filereport?accession=PRJEB5348&result=read_run&fields=run_accession,experiment_accession,sample_accession,secondary_sample_accession,study_accession,secondary_study_accession,scientific_name,library_strategy,library_source,library_selection,library_layout,instrument_platform,instrument_model,experiment_title,sample_title,nominal_length,read_count,base_count,fastq_ftp,fastq_md5,fastq_bytes&format=tsv&download=true"
PROFDGE_BASE_URL="https://raw.githubusercontent.com/bartongroup/profDGE48/${AUTHOR_COMMIT}"
AUTHOR_MAPPING_URL="${PROFDGE_BASE_URL}/Preprocessed_data/ENAdata_ERP004763_sample_mapping.tsv"
AUTHOR_BAD_REPS_URL="${PROFDGE_BASE_URL}/Bad_replicate_identification/exclude.lst"
WT_COUNTS_URL="${PROFDGE_BASE_URL}/Preprocessed_data/WT_countdata.tar.gz"
SNF2_COUNTS_URL="${PROFDGE_BASE_URL}/Preprocessed_data/Snf2_countdata.tar.gz"
SGD_REFERENCE_RELEASE="R64.4.1"
SGD_REFERENCE_ARCHIVE_DATE="2023-08-30"
SGD_REFERENCE_TARBALL_URL="http://sgd-archive.yeastgenome.org/sequence/S288C_reference/genome_releases/S288C_reference_genome_R64-4-1_20230830.tgz"
SGD_REFERENCE_TARBALL_NAME="S288C_reference_genome_R64-4-1_20230830.tgz"
SGD_REFERENCE_RAW_GENOME_MEMBER="S288C_reference_sequence_R64-4-1_20230830.fsa.gz"
SGD_REFERENCE_ANNOTATION_MEMBER="saccharomyces_cerevisiae_R64-4-1_20230830.gff.gz"
GO_BASIC_OBO_URL="https://current.geneontology.org/ontology/go-basic.obo"
GO_BASIC_OBO_NAME="go-basic.obo"

INPUTS="${OUTDIR}/00_inputs"
LOGS="${OUTDIR}/01_logs"
STEP_LOGS="${LOGS}/steps"
INTERMEDIATE="${OUTDIR}/02_intermediate"
RESULTS="${OUTDIR}/03_results"
REPORTS="${OUTDIR}/04_reports"

METADATA_DIR="${INTERMEDIATE}/metadata"
CACHE_DIR="${INTERMEDIATE}/cache"
COUNT_UNPACK_DIR="${INTERMEDIATE}/counts_unpacked"
TMP_DIR="${INTERMEDIATE}/tmp"

FASTQ_PKG="${RESULTS}/yeast-snf2-fastq-mini-v1"
COUNT_PKG="${RESULTS}/yeast-snf2-counts-medium-v1"
REF_PKG="${RESULTS}/yeast-reference-sgd-r64.4.1-v1"
GENESETS_PKG="${RESULTS}/yeast-sgd-go-gene-sets-r64.4.1-v1"
REF_SOURCE_DIR="${REF_PKG}/source"
REF_GENOME_DIR="${REF_PKG}/reference/genome"
REF_ANNOTATION_DIR="${REF_PKG}/reference/annotation"
GENESETS_SOURCE_DIR="${GENESETS_PKG}/source"
GENESETS_DIR="${GENESETS_PKG}/gene_sets"
GENESETS_BACKGROUND_DIR="${GENESETS_PKG}/background"
GENESETS_METADATA_DIR="${GENESETS_PKG}/metadata"

SELECTION_TSV="${INPUTS}/selected_replicates.tsv"
URLS_TSV="${INPUTS}/source_urls.tsv"
ENA_REPORT_TSV="${METADATA_DIR}/ena_PRJEB5348_read_run.tsv"
AUTHOR_MAPPING_TSV="${METADATA_DIR}/ENAdata_ERP004763_sample_mapping.tsv"
AUTHOR_BAD_REPS="${METADATA_DIR}/exclude.lst"
SOURCE_ACCESSIONS_TSV="${FASTQ_PKG}/source_accessions.tsv"
FASTQ_SAMPLES_TSV="${FASTQ_PKG}/samples.tsv"
FASTQ_GENERATED_SAMPLES_TSV="${FASTQ_PKG}/generated_samples.tsv"
FASTQ_METADATA_TSV="${FASTQ_PKG}/metadata.tsv"
FASTQ_STATS_TSV="${FASTQ_PKG}/expected/fastq_stats.tsv"
COUNT_SOURCE_TSV="${COUNT_PKG}/source_files.tsv"
COUNT_FILE_MAP_TSV="${COUNT_PKG}/source/count_file_map.tsv"
SELECTED_COUNT_FILES_TSV="${COUNT_PKG}/source/selected_count_files.tsv"
GENE_COUNTS_TSV="${COUNT_PKG}/counts/gene_counts_12v12.tsv"
REF_TARBALL="${REF_SOURCE_DIR}/${SGD_REFERENCE_TARBALL_NAME}"
REF_GENOME_FA="${REF_GENOME_DIR}/yeast_s288c_reference_genome_R64-4-1.fa"
REF_GENOME_FAI="${REF_GENOME_FA}.fai"
REF_ANNOTATION_GFF3="${REF_ANNOTATION_DIR}/yeast_s288c_gene_annotation_R64-4-1.gff3"
REF_SOURCE_TSV="${REF_PKG}/source_files.tsv"
REF_SUMMARY_TSV="${REF_PKG}/reference_summary.tsv"
REF_MANIFEST_JSON="${REF_PKG}/manifest.json"
REF_README_MD="${REF_PKG}/README.md"
GO_BASIC_OBO="${GENESETS_SOURCE_DIR}/${GO_BASIC_OBO_NAME}"
GENESETS_GO_TERMS_TSV="${GENESETS_METADATA_DIR}/go_terms.tsv"
GENESETS_GENE_GO_TERMS_TSV="${GENESETS_METADATA_DIR}/gene_go_terms.tsv"
GENESETS_INDEX_TSV="${GENESETS_METADATA_DIR}/gene_set_index.tsv"
GENESETS_BACKGROUND_TSV="${GENESETS_BACKGROUND_DIR}/yeast_background_genes.tsv"
GENESETS_GO_BP_GMT="${GENESETS_DIR}/sgd_go_bp.gmt"
GENESETS_GO_MF_GMT="${GENESETS_DIR}/sgd_go_mf.gmt"
GENESETS_GO_CC_GMT="${GENESETS_DIR}/sgd_go_cc.gmt"
GENESETS_GO_ALL_GMT="${GENESETS_DIR}/sgd_go_all.gmt"
GENESETS_SOURCE_TSV="${GENESETS_PKG}/source_files.tsv"
GENESETS_SUMMARY_TSV="${GENESETS_PKG}/gene_sets_summary.tsv"
GENESETS_MANIFEST_JSON="${GENESETS_PKG}/manifest.json"
GENESETS_README_MD="${GENESETS_PKG}/README.md"
COMMANDS_SH="${REPORTS}/commands.sh"
VERSIONS_TSV="${REPORTS}/versions.tsv"
METHODS_TXT="${REPORTS}/methods.txt"
FLOW_SUMMARY_TSV="${REPORTS}/flow_summary.tsv"
MANIFEST_JSON="${OUTDIR}/run.manifest.json"

die() {
    printf '%s\n' "ERROR: $*" >&2
    exit 1
}

log() {
    printf '%s %s\n' "$(date '+%Y-%m-%d %H:%M:%S')" "$*" | tee -a "${LOGS}/flow.log"
}

stage_begin() {
    log ""
    log "==> BEGIN stage: $1"
}

stage_done() {
    log "==> DONE stage: $1"
}

require_positive_int() {
    name="$1"
    value="$2"
    case "$value" in
        ''|*[!0-9]*) die "${name} must be a non-negative integer" ;;
    esac
}

bool_is_valid() {
    case "$1" in
        true|false) return 0 ;;
        *) return 1 ;;
    esac
}

md5_file() {
    if command -v md5sum >/dev/null 2>&1; then
        md5sum "$1" | awk '{print $1}'
    elif command -v md5 >/dev/null 2>&1; then
        md5 -q "$1"
    else
        die "Neither md5sum nor md5 is available"
    fi
}

sha256_file() {
    if command -v sha256sum >/dev/null 2>&1; then
        sha256sum "$1" | awk '{print $1}'
    elif command -v shasum >/dev/null 2>&1; then
        shasum -a 256 "$1" | awk '{print $1}'
    else
        die "Neither sha256sum nor shasum is available"
    fi
}

write_fasta_fai() {
    fasta="$1"
    fai="$2"
    tmp="${fai}.tmp"
    rm -f "$tmp"
    awk '
        function flush_record() {
            if (name != "") {
                print name "\t" seqlen "\t" seq_offset "\t" line_bases "\t" line_width
            }
        }
        BEGIN {
            offset = 0
            name = ""
        }
        /^>/ {
            flush_record()
            header = substr($0, 2)
            split(header, fields, /[ \t]+/)
            name = fields[1]
            seqlen = 0
            line_bases = 0
            line_width = 0
            seq_offset = offset + length($0) + 1
            offset += length($0) + 1
            next
        }
        {
            line = $0
            sub(/\r$/, "", line)
            bases = length(line)
            if (name != "" && bases > 0) {
                if (line_bases == 0) {
                    line_bases = bases
                    line_width = length($0) + 1
                }
                seqlen += bases
            }
            offset += length($0) + 1
        }
        END {
            flush_record()
        }
    ' "$fasta" > "$tmp"
    [ -s "$tmp" ] || die "Failed to generate FASTA index: ${fai}"
    mv "$tmp" "$fai"
}

file_size_bytes() {
    if [ -f "$1" ]; then
        wc -c < "$1" | awk '{print $1}'
    else
        printf '0\n'
    fi
}

format_bytes() {
    awk -v b="$1" 'BEGIN {
        if (b == "" || b == ".") {
            print "unknown"
        } else if (b < 1024) {
            printf "%d B", b
        } else if (b < 1024 * 1024) {
            printf "%.1f KB", b / 1024
        } else if (b < 1024 * 1024 * 1024) {
            printf "%.1f MB", b / 1024 / 1024
        } else {
            printf "%.2f GB", b / 1024 / 1024 / 1024
        }
    }'
}

tsv_records() {
    awk 'NR > 1 { n++ } END { print n + 0 }' "$1"
}

tsv_unique_first_col() {
    awk 'NR > 1 && !seen[$1]++ { n++ } END { print n + 0 }' "$1"
}

record_cmd() {
    printf '%s\n' "$*" >> "$COMMANDS_SH"
}

ensure_layout() {
    case "$STAGE" in
        plan|metadata|counts|reference|genesets|fastq|all) ;;
        *) die "--stage must be one of: plan, metadata, counts, reference, genesets, fastq, all" ;;
    esac

    case "$PROFILE" in
        standard|lite) ;;
        *) die "--profile must be one of: standard, lite" ;;
    esac

    bool_is_valid "$FORCE" || die "--force must be true or false"
    bool_is_valid "$RESUME" || die "--resume must be true or false"
    bool_is_valid "$KEEP_LANES" || die "--keep-lanes must be true or false"

    require_positive_int "--reads-per-sample" "$READS_PER_SAMPLE"
    require_positive_int "--seed" "$SEED"
    require_positive_int "--threads" "$THREADS"
    require_positive_int "--limit-samples" "$LIMIT_SAMPLES"

    [ "$READS_PER_SAMPLE" -gt 0 ] || die "--reads-per-sample must be > 0"
    [ "$THREADS" -gt 0 ] || die "--threads must be > 0"

    if [ -e "$OUTDIR" ] && [ "$FORCE" != "true" ] && [ "$RESUME" != "true" ]; then
        die "Output directory already exists: ${OUTDIR}. To continue a previous plan/metadata/counts/reference/fastq run, add --resume true. To redownload/overwrite existing files, add --force true."
    fi

    mkdir -p "$INPUTS" "$STEP_LOGS" "$METADATA_DIR" "$CACHE_DIR" "$COUNT_UNPACK_DIR" "$TMP_DIR"
    mkdir -p "$FASTQ_PKG/reads" "$FASTQ_PKG/expected" "$COUNT_PKG/source" "$COUNT_PKG/counts"
    mkdir -p "$REF_SOURCE_DIR" "$REF_GENOME_DIR" "$REF_ANNOTATION_DIR" "$REPORTS"
    mkdir -p "$GENESETS_SOURCE_DIR" "$GENESETS_DIR" "$GENESETS_BACKGROUND_DIR" "$GENESETS_METADATA_DIR"

    {
        printf '%s\n' '#!/bin/sh'
        printf '%s\n' 'set -eu'
        printf '%s\n' ''
        printf '# Commands executed during this invocation: %s\n' "$(date '+%Y-%m-%d %H:%M:%S')"
        printf '%s\n' ''
    } > "$COMMANDS_SH"
    chmod +x "$COMMANDS_SH"
}

